{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@enterprise/notification-sdk": [
        "../notification-sdk/src/index.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
